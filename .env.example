# Copy this file to `.env` to change a setting. Every setting has a default.

# Port on this machine where the app is reachable.
APP_PORT=8501

# Largest file the upload box accepts, in megabytes.
MAX_UPLOAD_MB=200

# Set to 1 on a public demo. Each visitor then trains a private model that lasts for
# their browser session, and the built-in demo model is never overwritten. Leave it
# at 0 on your own machine so a trained model is kept in the models/ folder.
DEMO_MODE=0
